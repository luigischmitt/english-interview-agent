export type WordBlock = { id: number; text: string; trailing: string };
export function toBlocks(sentence: string): WordBlock[];
export function normalizeEdits(blocks: WordBlock[], edits: Record<number, string>): Record<number, string>;
export function isOrderChanged(order: number[], originalOrder?: number[]): boolean;
export type WordGap = { index: number; x: number; y: number };
export function gapsFromRects(rects: Array<{ left: number; top: number; width: number; height: number; right?: number; bottom?: number }>): WordGap[];
export function nearestGap(gaps: WordGap[], x: number, y: number): WordGap | null;
export function orderFromGap(order: number[], draggedId: number, gapIndex: number): number[];
export function insertionIndexFromRects(rects: Array<{ left: number; top: number; width: number; height: number }>, x: number, y: number, draggedIndex?: number): number;
export function reorder(order: number[], draggedId: number, targetIndex: number): number[];
export type DragState = { order: number[]; dragging: null | { id: number; x: number; y: number; startX: number; startY: number; moved?: boolean }; placeholderIndex: number | null; openEditorFor: number | null; suppressClick: boolean };
export type DragEvent = { type: "pointerdown"; id: number; x: number; y: number } | { type: "move"; x: number; y: number; targetIndex: number } | { type: "up" | "cancel" | "click" };
export function dragReducer(state: DragState | null, event: DragEvent): DragState;
export function applyEdits(blocks: WordBlock[], edits: Record<number, string>, order?: number[]): string;
export function mistakeRegion(exercise: { sentence: string; answer: string }): { blockIds: number[]; correct: string; mistaken: string };
export function alternativesFor(exercise: { id: string; ruleId: string; sentence: string; answer: string; choices?: string[] }, lessons: Array<{ exercises?: Array<{ id: string; ruleId: string; kind: string; options?: string[] }> }>, random?: () => number): Array<{ value: string; label: string }>;
